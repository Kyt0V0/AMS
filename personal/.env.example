# Copy to ".env" (same folder) to change the defaults. Every line is optional.
# There is no setting for the network address: AMS Personal only serves this computer.

# Where your encrypted vault is stored.
# AMS_DATA_DIR=./data

# Port on this computer.
# AMS_PORT=8100

# Set to 1 to stop the browser opening automatically at start.
# AMS_NO_BROWSER=0

# The vault locks itself after this many idle minutes at the latest (the in-app
# auto-lock setting is usually shorter), and always after this many hours.
# AMS_SESSION_IDLE_MINUTES=15
# AMS_SESSION_MAX_HOURS=12
