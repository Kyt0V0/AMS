<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ams.backend</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/path/to/AMS/startup/backend_service_macos.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/path/to/AMS/backend</string>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/path/to/AMS/backend/launchd_backend.log</string>
  <key>StandardErrorPath</key>
  <string>/path/to/AMS/backend/launchd_backend.err.log</string>
</dict>
</plist>
