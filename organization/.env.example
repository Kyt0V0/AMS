# Copy to ".env" (same folder) to change the defaults. Every line is optional.

# Where the database, server key, setup token and generated certificate live.
# AMS_DATA_DIR=./data

# Address and port to listen on. 127.0.0.1 = this computer only.
# Serving the network needs HTTPS: use "python3 scripts/start.py --lan", or set the two TLS lines below.
# AMS_HOST=127.0.0.1
# AMS_PORT=8000
# AMS_TLS_CERT=/path/to/cert.pem
# AMS_TLS_KEY=/path/to/key.pem

# Host names clients may use to reach AMS (comma separated). Requests that arrive under
# any other name are refused (DNS-rebinding protection). "scripts/start.py --lan" fills
# this in by itself; set it yourself when you use your own certificate or a reverse proxy.
# AMS_ALLOWED_HOSTS=ams.example.lan,192.168.1.20

# Set to 1 only when AMS runs behind your own HTTPS reverse proxy on the same machine.
# AMS_BEHIND_PROXY=0

# Sessions: sign out after this many idle minutes / after this many hours in total.
# AMS_SESSION_IDLE_MINUTES=15
# AMS_SESSION_MAX_HOURS=12

# Server key (base64 of 32 random bytes) used to protect user names and e-mails at rest.
# If unset, one is generated in <data dir>/secret.key. Supplying it here keeps it apart from the database.
# AMS_SECRET_KEY=

# ---- E-mail (needed for two-step sign-in and verified e-mail changes) ----
# Outgoing mail server. Check it with:  backend/.venv/bin/python scripts/test_email.py you@example.com
# AMS_SMTP_HOST=smtp.example.com
# AMS_SMTP_PORT=587
# Security is one of: starttls (port 587), ssl (port 465), none (trusted local relay only).
# AMS_SMTP_SECURITY=starttls
# AMS_SMTP_USER=ams@example.com
# AMS_SMTP_PASSWORD=
# AMS_SMTP_FROM=AMS <ams@example.com>

# Development only: print e-mails in the server window instead of sending them.
# AMS_EMAIL_DEBUG=0
